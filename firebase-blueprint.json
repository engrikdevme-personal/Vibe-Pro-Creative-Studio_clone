{
  "entities": {
    "UserSession": {
      "title": "UserSession",
      "description": "A session for a user.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "The unique identifier of the session." },
        "type": { "type": "string" },
        "title": { "type": "string" },
        "inputText": { "type": "string" },
        "outputText": { "type": "string" },
        "messages": {
            "type": "array",
            "items": { "type": "string" }
        },
        "history": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string" },
                "label": { "type": "string" },
                "inputText": { "type": "string" },
                "outputText": { "type": "string" },
                "timestamp": { "type": "string" }
              },
              "required": ["id", "label", "inputText", "outputText", "timestamp"]
            }
        },
        "lastUpdated": { "type": "string" }
      },
      "required": ["id", "type", "title"]
    }
  },
  "firestore": {
    "/users/{userId}/sessions/{sessionId}": {
      "schema": { "$ref": "#/entities/UserSession" },
      "description": "Stores user sessions."
    }
  }
}
